# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shift

# Required in production for verified email login links.
PUBLIC_APP_URL=https://shift.example.com
RESEND_API_KEY=
SHIFT_FROM_EMAIL=Shift <login@account.example.com>

# Required only when customers store external AI provider credentials.
# Generate with: openssl rand -base64 32
SHIFT_ENCRYPTION_KEY=

# Required in production. Use a unique random value with at least 32 UTF-8
# bytes to authorize short-lived embed telemetry events.
EVENT_SIGNING_KEY=

# Local/test-only fallback. This is rejected when NODE_ENV=production.
ALLOW_DEV_EVENT_SIGNING_KEY=false

# Local development only. Returns one-time links in API responses. Never enable
# in production.
ALLOW_DEV_AUTH_TOKENS=false

# Optional trusted reverse-proxy IP/CIDR or named subnet list. Broad true or
# numeric hop-count trust is rejected. Leave false unless the proxy is known.
SHIFT_TRUST_PROXY=false

PORT=8080
NODE_ENV=development
